{
  "name": "familienkalender-app",
  "version": "1.2.0",
  "private": true,
  "description": "Familienkalender (statische PWA ohne Build-Schritt): Unit- und End-to-End-Tests",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:alle": "npm run test:unit && npm run test:e2e",
    "test:visuell": "playwright test -c playwright.visuell.config.js",
    "test:webkit": "playwright test --project=webkit-glas --project=webkit-bento",
    "test:kontrast": "node tests/visuell/kontrast.mjs",
    "test:leistung": "node tests/visuell/leistung.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
